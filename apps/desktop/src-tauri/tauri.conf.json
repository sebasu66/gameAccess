{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gameAccess",
  "version": "0.1.5",
  "identifier": "com.gameaccess.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:38148",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gameAccess",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#07090d"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://*.steamstatic.com https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://store.akamai.steamstatic.com data: blob:; media-src 'self' https://*.steamstatic.com https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://store.akamai.steamstatic.com blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": {
      "runtime/launcher": "runtime/launcher",
      "runtime/python": "runtime/python",
      "../../../deploy/catalog-cache": "runtime/catalog",
      "../../../tools/windows/kid-account.ps1": "runtime/kid-account.ps1"
    },
    "icon": [
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "gameaccess-desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MkUzOUYwRUQ3MjFGNUUKUldSZUgzTHQ4RGt1UkdDa2pwbmJwcWxpSUtiVXFYdzlMYjR3Sm5PR1kyck1JOHl0TUxJNU5uUnYK",
      "endpoints": [
        "https://github.com/sebasu66/gameAccess/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
