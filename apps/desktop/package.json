{
  "name": "gameaccess-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 38148",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 38148",
    "prepare-icons": "node scripts/prepare-icons.mjs",
    "pretauri": "npm run prepare-icons && npm run prepare-python-runtime && npm run prepare-catalog-seed && npm run prepare-bundled-artwork",
    "tauri": "tauri",
    "prepare-python-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
    "prepare-catalog-seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-catalog-seed.ps1",
    "prepare-bundled-artwork": "python scripts/prepare-bundled-artwork.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "hls.js": "1.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
